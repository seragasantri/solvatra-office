{
  "name": "solvatra-office",
  "productName": "Solvatra Office",
  "version": "0.1.0",
  "description": "Suite office ber-AI: Markdown, Slides, dan lainnya — memakai akun & model Solvatra AI.",
  "author": { "name": "Solvatra AI", "email": "admin@tragasolusi.com" },
  "license": "Apache-2.0",
  "homepage": "https://solvatra.web.id",
  "repository": { "type": "git", "url": "https://github.com/seragasantri/solvatra-office" },
  "main": "src/main.js",
  "scripts": {
    "bundle": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "npm run bundle && electron .",
    "dist:mac": "npm run bundle && electron-builder --mac",
    "dist:win": "npm run bundle && electron-builder --win",
    "dist": "npm run bundle && electron-builder -mwl"
  },
  "build": {
    "appId": "id.web.solvatra.office",
    "productName": "Solvatra Office",
    "artifactName": "Solvatra-Office-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["src/**/*", "renderer/index.html", "renderer/styles.css", "renderer/dist/**/*", "preload.js", "package.json"],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false },
    "linux": { "target": ["AppImage", "deb"], "category": "Office", "icon": "build/icon.png" }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "docx": "^9.0.0",
    "pptxgenjs": "^4.0.0"
  }
}
